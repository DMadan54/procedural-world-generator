#!/bin/sh
# Rejects commit messages that carry AI attribution of any kind.
# Enable once per clone with: git config core.hooksPath .githooks

msg_file="$1"
pattern='co-authored-by|generated with|claude-session|claude\.ai|anthropic\.com'

# Number lines as they are in the message, then drop the comment lines git
# adds to the template.
matches=$(grep -inE "$pattern" "$msg_file" | grep -v '^[0-9]*:#')
if [ -n "$matches" ]; then
    echo "commit-msg: rejected, the message contains attribution:" >&2
    echo "$matches" | sed 's/^/  line /' >&2
    exit 1
fi
exit 0
